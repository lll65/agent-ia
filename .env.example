# Copie ce fichier en .env et remplis les valeurs

# === LLM — choisis un provider ===

# Option A: Groq (gratuit, recommandé) → console.groq.com
GROQ_API_KEY=             # commence par gsk_...

# Option B: xAI/Grok → console.x.ai
XAI_API_KEY=              # commence par xai-...

# Option C: Ollama local (nécessite beaucoup de RAM)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=tinyllama    # tinyllama, llama3.2:1b, llama3.2...

# === SERVEUR ===
HOST=0.0.0.0
PORT=8000
GRADIO_PORT=7860
GRADIO_SHARE=false         # true = lien public (ngrok-like)

# === AGENT ===
MAX_ITERATIONS=12
MAX_RETRIES=3
SUMMARY_THRESHOLD=15       # résume la mémoire tous les N messages

# === BOTS (optionnels) ===
# Telegram: obtiens ton token via @BotFather sur Telegram (gratuit)
TELEGRAM_TOKEN=

# Discord: crée ton bot sur discord.com/developers/applications (gratuit)
DISCORD_TOKEN=
DISCORD_GUILD_ID=

# === VIDÉO ===
VIDEO_RESOLUTION=1080x1920
VIDEO_FPS=24
