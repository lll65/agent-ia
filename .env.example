# Copie ce fichier en .env et remplis les valeurs

# === LLM — choisis un provider ===

# Option A: Groq (gratuit, recommandé) → console.groq.com
# Recherche web fiable (serveur) — clé gratuite sur tavily.com (~1000/mois). Optionnel.
# Passerelle universelle : mot de passe pour parler a l'agent depuis n'importe quel appareil
# (Siri, n8n, webhook). Choisis une valeur longue. Vide = passerelle desactivee.
AGENT_API_KEY=

TAVILY_API_KEY=

GROQ_API_KEY=             # commence par gsk_...

# Option B: xAI/Grok → console.x.ai
XAI_API_KEY=              # commence par xai-...

# Option C: Cerebras (gratuit, inference ultra-rapide) → cloud.cerebras.ai
#   Sert de FALLBACK automatique : si Groq renvoie 429, on bascule sur Cerebras.
CEREBRAS_API_KEY=         # commence par csk-...
CEREBRAS_MODEL=llama-3.3-70b

# Option D: Google AI Studio (Gemini 2.5 Flash) → ai.google.dev (gratuit, SANS carte bancaire)
GEMINI_API_KEY=           # commence par AIza...
GEMINI_MODEL=gemini-2.5-flash

# Option E: Ollama local (idéal avec un GPU 8 Go VRAM)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b  # tinyllama, llama3.2:1b, llama3.1:8b (8 Go VRAM)...

# === MÉMOIRE PERSISTANTE (optionnel — Supabase Postgres + pgvector) ===
# Si défini, la mémoire de l'agent SURVIT aux redémarrages / mises en veille
# (indispensable en hébergement éphémère type Render free). Sinon → SQLite + ChromaDB locaux.
# URL: Supabase → Project Settings → Database → Connection string → URI
# (n'oublie pas de remplacer [YOUR-PASSWORD]).
SUPABASE_DB_URL=          # postgresql://postgres:MOT_DE_PASSE@db.xxxx.supabase.co:5432/postgres

# === SERVEUR ===
HOST=0.0.0.0
PORT=8000
GRADIO_PORT=7860
GRADIO_SHARE=false         # true = lien public (ngrok-like)

# === FUSEAU HORAIRE ===
# ⚠️ Le conteneur Render tourne en UTC. Sans ce reglage, une automatisation planifiee
# « a 7h » partait a 9h heure de Paris (et le bilan du dimanche pouvait tomber un lundi).
# Verifie sur /agent/diag/automatisations?key=TA_CLE -> « decalage_avec_le_serveur_h ».
FUSEAU=Europe/Paris

# === AGENT ===
MAX_ITERATIONS=12
MAX_RETRIES=3
SUMMARY_THRESHOLD=15       # résume la mémoire tous les N messages
AGENT_TIMEOUT=75           # délai TOTAL d'un tour (recherche + rédaction)

# === DÉLAIS DES MODÈLES ===
# ⚠️ Ces trois valeurs se tiennent : le budget de la chaîne est PARTAGÉ entre 3
# fournisseurs, donc le premier essayé n'obtient jamais plus que
# LLM_TIMEOUT_TOTAL / 3, même si LLM_TIMEOUT est plus grand.
#   LLM_TIMEOUT=35 seul, avec LLM_TIMEOUT_TOTAL=70  → 23 s réels (aucun effet)
#   LLM_TIMEOUT=35 AVEC   LLM_TIMEOUT_TOTAL=110     → 35 s réels ✅
# Et AGENT_TIMEOUT doit rester au-dessus de LLM_TIMEOUT_TOTAL, sinon l'agent
# abandonne avant que la chaîne de secours ait fini.
# Vérifie le résultat sur /agent/diag/llm?key=TA_CLE → « delai_reel_1er_essai_s ».
LLM_TIMEOUT=22             # délai PAR fournisseur (réponse complète)
LLM_TIMEOUT_TOTAL=70       # budget de TOUTE la chaîne de secours
LLM_TIMEOUT_STREAM=60      # délai en streaming (plus long, ça coule)
LLM_PANNE_TTL=600          # secondes de mise à l'écart après une panne franche
LLM_LENT_TTL=120           # secondes de mise à l'écart quand c'est juste lent

# Option H: Mistral (gratuit, SANS carte, offre tres genereuse) → console.mistral.ai
#   Modeles entraines en francais : la qualite des reponses de Nova s'en ressent.
MISTRAL_API_KEY=          # commence par ...

# Option I: SambaNova (gratuit, 200k tokens/jour par modele) → cloud.sambanova.ai
# Option J: Cloudflare Workers AI (gratuit, 10 000 neurones/jour) → dash.cloudflare.com

# Option F: NVIDIA NIM (gratuit) → build.nvidia.com  (compte à VÉRIFIER par e-mail)
NVIDIA_API_KEY=            # commence par nvapi-...

# Option G: OpenRouter (agrégateur, modèles gratuits) → openrouter.ai
OPENROUTER_API_KEY=        # commence par sk-or-...

# === BOTS (optionnels) ===
# Telegram: obtiens ton token via @BotFather sur Telegram (gratuit)
TELEGRAM_TOKEN=
# Cible des alertes push (optionnel) : ton chat_id numérique. Si vide, le watcher
# envoie à tous les chats ayant fait /start (enregistrés dans data/telegram_chats.json).
TELEGRAM_CHAT_ID=

# Discord: crée ton bot sur discord.com/developers/applications (gratuit)
DISCORD_TOKEN=
DISCORD_GUILD_ID=

# === PEA WATCHER (surveillance autonome + alertes Telegram) ===
WATCHER_ENABLED=false       # true = scanne data/watchlist.txt et push les alertes
WATCHER_INTERVAL=1800       # secondes entre deux scans (1800 = 30 min, plancher 300)
WATCHER_RSI_LOW=32          # RSI ≤ seuil → alerte "survendu / zone d'achat"
WATCHER_RSI_HIGH=70         # RSI ≥ seuil → alerte "suracheté / prendre profits"
WATCHER_MOVE_PCT=5.0        # variation journalière |%| ≥ seuil → alerte "gros mouvement"
WATCHER_QUIET_HOURS=20      # une même alerte n'est pas répétée avant N heures

# === VIDÉO ===
VIDEO_RESOLUTION=1080x1920
VIDEO_FPS=24
